section(aria-labelledby='faq-heading').faq
  div.faq__container
    div.faq__title-wrapper
      h2#faq-heading.faq__title FAQ
    ul.accordion.js-accordion
      each accordionItem, index in accordionList
        +accordion-item({...accordionItem, index})
  div.ribbons.faq__ribbons.motion.js-motion
    span.visually-hidden Get inspired
    div.ribbons__wrapper(aria-hidden='true')
      +ribbon('ribbons__item_back')
      +ribbon('ribbons__item_front')
