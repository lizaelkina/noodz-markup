include ../helpers/mixins
include ../data/site

block variables

-
  const current = Object.assign({title: '', description: '', bodyClass: ''}, typeof page === 'undefined' ? {} : page);
  const documentTitle = current.title ? `${current.title} | ${site.name}` : site.name;

doctype html
html(lang=site.lang)
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    if current.base && production
      base(href=current.base)
    meta(name="description" content=current.description || site.description)
    meta(name="author" content=site.author)
    title= documentTitle
    != faviconHtml
    link(rel="stylesheet" href="styles/main.css")
    block head
  body.root(class=current.bodyClass || false)
    div.page
      block header
        include ../../blocks/modules/header/header
      main.content
        block content
      block footer
        include ../../blocks/modules/footer/footer
    script(defer src="js/main.js")
    block scripts
