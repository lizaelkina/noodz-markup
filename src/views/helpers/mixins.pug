mixin img(src, alt)
  -
    if (alt == null) {
      throw new Error(`+img: alt is required for "${src}", pass '' for a decorative image`);
    }
  -
    attributes.loading = attributes.loading === 'eager' ? false : attributes.loading || 'lazy';
    const size = imageSizes && imageSizes[src.replace(/^(\.\/)?img\//, '').replace(/\.[a-z0-9]+$/i, '')];
    if (size && attributes.width == null && attributes.height == null) {
      attributes.width = size.width;
      attributes.height = size.height;
    }
    if (attributes.sizes) {
      if (/\.[a-z0-9]+$/i.test(src) || !size) {
        throw new Error(`+img: sizes needs a PNG/JPEG/TIFF from src/img without an extension, got "${src}"`);
      }
      attributes.srcset = [...size.widths.map(width => `${src}-${width}w.webp ${width}w`), `${src}.webp ${size.width}w`].join(', ');
    }
    if (/\.(png|jpe?g|tiff)$/i.test(src)) {
      throw new Error(`+img: "${src}" is not copied to dist, drop the extension to use its WebP copy`);
    }
  img(src=/\.[a-z0-9]+$/i.test(src) ? src : src + '.webp', alt=alt)&attributes(attributes)

mixin svg(name)
  svg(data-svg=name aria-hidden='true')&attributes(attributes)
    use(href=`./img/sprites/sprite.svg#${name}`)

mixin button(name, href)
  a.button(href=href)&attributes(attributes)
    span.button__text= name

mixin header-logo
  div.logo&attributes(attributes)
    +svg('logo').logo__header
    span.visually-hidden Noodz

mixin pills(color, section)
  each pos in ['top', 'left', 'bottom']
    +svg('pill').pill(class=[`pill_${color}`, `pill_${section}-${pos}`])

mixin stars
  div.stars.motion.js-motion(aria-hidden='true')
    each _ in Array(6)
      +svg('star').stars__svg

mixin smile
  div.smile.motion.js-smile.js-motion(aria-hidden='true')&attributes(attributes)
    +img('./img/smile-face.svg', '')(width='382' height='392').smile__face
    +img('./img/smile-tongue-shadow.svg', '').smile__tongue.js-smile-tongue
    each bubble in ['left-top', 'left-bottom', 'right', 'left-top']
      span.smile__bubble
        +img(`./img/bubble-${bubble}.svg`, '').smile__bubble-img
        each _ in Array(6)
          span.smile__drop
    +img('./img/smile-mouth-star.svg', '').smile__mouth-star

mixin button-play-video
  button.play.motion.js-motion(type='button' aria-label='Play video')&attributes(attributes)
    +svg('play').play__svg

mixin accordion-item(data)
  - const panelId = `accordion-panel-${data.index + 1}`

  li.accordion__item.js-accordion-item
    div.accordion__container
      h3
        button.accordion__button.js-accordion-button(type='button' aria-expanded='false' aria-controls=panelId)
          span.accordion__title(lang='nl')= data.title
          +svg('plus').accordion__svg
      div.accordion__wrapper(id=panelId)
        div.accordion__inner
          p.accordion__content(lang='nl')= data.text

mixin ribbon(itemClass)
  div.ribbons__item(class=itemClass)
    div.ribbons__marquee(class=(itemClass === 'ribbons__item_back' && 'ribbons__marquee_reverse'))
      each _ in Array(2)
        div.ribbons__track
          each _ in Array(8)
            span.ribbons__text Get inspired

mixin card(data)
  -
    const mod = ['left', 'center', 'right'][data.index];
    if (!mod) {
      throw new Error(`+card: the block has exactly 3 cards, got index ${data.index}`);
    }

  li.card(class=[`card_${mod}`])&attributes(attributes)
    div.card__title-wrapper
      p.card__title= data.title
    +svg('pill').pill.pill_card(class=`pill_card-${mod}`)
    if data.linkTitle
      a.button.card__button(
        class=`card__button_${mod}`
        href=data.linkHref
        target='_blank'
        rel='noopener'
        aria-label=`${data.linkTitle} (opens in new tab)`)
        span.button__text.card__button-text(class=`card__button-text_${mod}`)= data.linkTitle
    if data.img
      +img(data.img, '').card__img(class=`card__img_${mod}` aria-hidden='true')
